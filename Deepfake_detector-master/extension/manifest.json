{
  "manifest_version": 3,
  "name": "ClearSight — Forensic Deepfake Detector & Media Restoration",
  "version": "2.0",
  "description": "Detect deepfakes in images and videos, and restore images with AI enhancement",
  "permissions": ["contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:5002/*",
    "http://localhost:5002/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
